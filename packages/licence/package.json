{
  "name": "@kiln/licence",
  "version": "0.0.0",
  "private": true,
  "description": "Licence types, Ed25519 signing (builder only) and verification (POS)",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./sign": {
      "types": "./src/sign.ts",
      "default": "./dist/sign.js"
    },
    "./verify": {
      "types": "./src/verify.ts",
      "default": "./dist/verify.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@kiln/client-config": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@kiln/eslint-config": "workspace:*",
    "@kiln/typescript-config": "workspace:*",
    "@types/node": "22.19.9",
    "@vitest/coverage-v8": "4.0.18",
    "eslint": "^9.39.5",
    "typescript": "5.7.3",
    "vitest": "4.0.18"
  }
}
