{
  "name": "@kiln/client-config",
  "version": "0.0.0",
  "private": true,
  "description": "Zod schema and types for client.config.json",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@kiln/eslint-config": "workspace:*",
    "@kiln/typescript-config": "workspace:*",
    "@types/node": "22.19.9",
    "eslint": "^9.39.5",
    "typescript": "5.7.3",
    "vitest": "4.0.18"
  }
}
