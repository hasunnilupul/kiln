{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      "passThroughEnv": ["DATABASE_URI", "PAYLOAD_SECRET"]
    },
    "dev": {
      "persistent": true,
      "cache": false,
      "passThroughEnv": ["PORT"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "topo": {
      "dependsOn": ["^topo"]
    },
    "check-types": {
      "dependsOn": ["topo"]
    },
    "test": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URI", "PAYLOAD_SECRET"]
    },
    "test:e2e": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URI", "PAYLOAD_SECRET", "CI"]
    }
  }
}
