# Local development. Start the database with: docker compose up -d db
DATABASE_URI=postgres://kiln:kiln@localhost:5432/kiln_builder
# At least 32 random bytes, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Also seals the owners' TOTP secrets: changing it means every owner sets up TOTP again.
PAYLOAD_SECRET=

# First boot creates the owner from these when there is none (BR-01). The owner sets up an
# authenticator app on their first sign-in, so sign in straight after the first deploy.
# Not needed once an owner exists. The password needs at least 16 characters.
BUILDER_OWNER_EMAIL=
BUILDER_OWNER_PASSWORD=

# Licence signing key (BR-31): run `pnpm licence:keygen` and paste the one-line value. Required in
# production. Back it up: losing it means existing builds cannot be renewed.
LICENCE_SIGNING_KEY=

# Client builds (BR-20). The builder's public base URL: the build workflow calls back to it and
# client builds check their licence in with it.
BUILDER_PUBLIC_URL=
# Fine-grained token for the template repository only: Actions read/write, Contents read.
BUILDER_GITHUB_TOKEN=
# owner/name of the template repository.
BUILDER_GITHUB_REPOSITORY=
# Optional: workflow file and the branch it runs from (defaults: build-client.yml on main).
BUILDER_WORKFLOW_FILE=
BUILDER_WORKFLOW_REF=
# The private R2 bucket the workflow uploads zips to (BR-23). The builder checks each upload and
# signs 15-minute download links, so an R2 API token with Object Read only is enough here.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional IP allowlist (BR-03): comma- or space-separated addresses and CIDR ranges, e.g.
# 203.0.113.7, 198.51.100.0/24. Empty allows every address. The client IP comes from
# x-real-ip / x-forwarded-for, so run the builder behind a proxy that sets them (Vercel, nginx, Caddy).
# POS licence check-ins (/api/licence-check) and the build workflow's job and callback routes are
# always allowed; each has its own credential.
BUILDER_IP_ALLOWLIST=
