# Local development. Start the database with: docker compose up -d db
DATABASE_URI=postgres://kiln:kiln@localhost:5432/kiln_pos
# At least 32 random bytes, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# First boot seeds an empty database from client.config.json and creates its admin with this
# password (at least 12 characters), which must be changed on first login. Not needed afterwards.
INITIAL_ADMIN_PASSWORD=
# Optional: where client.config.json lives. Defaults to client.config.json in the working directory.
CLIENT_CONFIG_PATH=

# Base URL; its host must be in the licence's allowed hosts. Defaults to http://localhost:PORT
# in development; required in production.
PUBLIC_URL=
# Licence (FR-04). Without licence.json, development runs unlicensed; production refuses to serve.
# Optional: where licence.json lives. Defaults to licence.json in the working directory.
LICENCE_PATH=
# Development only: public key for a licence from `pnpm licence:dev`. Production builds use the
# embedded key and ignore this.
LICENCE_PUBLIC_KEY=
# Development only: builder URL for the daily licence check-in, e.g. http://localhost:3001.
# Production builds embed it. Empty means the licence is checked offline only.
LICENCE_SERVER_URL=

# Media storage: r2 or vercel-blob. Leave empty in development to store uploads on local disk;
# a production server refuses to start without r2 or vercel-blob.
STORAGE_DRIVER=
# When STORAGE_DRIVER=r2 (Cloudflare R2; the bucket stays private, files are served by the POS)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# When STORAGE_DRIVER=vercel-blob
BLOB_READ_WRITE_TOKEN=
